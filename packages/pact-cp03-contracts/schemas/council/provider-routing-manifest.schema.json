{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layered-redraw.local/cp03/council/provider-routing-manifest.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "route",
        "model",
        "adapterPackage",
        "adapterVersion",
        "promptHash",
        "toolProfile",
        "maximumConcurrency",
        "inputClasses",
        "inputLimitTokens",
        "outputLimitTokens",
        "timeoutMs"
      ],
      "properties": {
        "provider": { "enum": ["deepseek", "gemini"] },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\s]+$"
        },
        "adapterPackage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\s]+$"
        },
        "adapterVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "promptHash": { "$ref": "#/$defs/hash" },
        "toolProfile": { "const": "council-v2" },
        "maximumConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "inputClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["text", "image", "audio"] }
        },
        "inputLimitTokens": {
          "type": "integer",
          "minimum": 1
        },
        "outputLimitTokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12000
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "plannedDispatches",
    "maximumDispatches",
    "assignments"
  ],
  "properties": {
    "schemaVersion": { "const": "cp03-council-routing/0.1" },
    "manifestVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "plannedDispatches": { "const": 6 },
    "maximumDispatches": { "const": 8 },
    "assignments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CaseConductor", "Witness", "Archivist", "Rewriter", "Guardian"],
      "properties": {
        "CaseConductor": { "$ref": "#/$defs/assignment" },
        "Witness": { "$ref": "#/$defs/assignment" },
        "Archivist": { "$ref": "#/$defs/assignment" },
        "Rewriter": { "$ref": "#/$defs/assignment" },
        "Guardian": { "$ref": "#/$defs/assignment" }
      }
    }
  }
}
