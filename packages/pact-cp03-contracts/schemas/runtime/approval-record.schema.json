{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layered-redraw.local/cp03/runtime/approval-record.schema.json",
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "caseSessionId",
    "turnId",
    "draftHash",
    "parentSceneHash",
    "decision",
    "approvedBy",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "cp03-runtime/0.1" },
    "approvalId": { "type": "string", "pattern": "^approval_[A-Za-z0-9_-]{8,80}$" },
    "caseSessionId": { "type": "string", "pattern": "^case_[A-Za-z0-9_-]{8,80}$" },
    "turnId": { "type": "string", "pattern": "^turn_[A-Za-z0-9_-]{8,80}$" },
    "draftHash": { "$ref": "#/$defs/hash" },
    "parentSceneHash": { "$ref": "#/$defs/hash" },
    "decision": { "enum": ["APPROVE", "REJECT"] },
    "approvedBy": { "const": "viewer" },
    "decidedAt": { "type": "string", "format": "date-time" }
  }
}
